# --- gtm (ex /opt/gtm) ---
gtm.korvus.fr {
	# Seules les routes qui doivent etre joignables sans basicauth : collecteur
	# du site (public, CORS), rapport analytics (jeton Bearer), extension Chrome
	# (secret extension), webhook lemlist (secret). Tout le reste de /api/* est
	# lu par le dashboard, donc derriere basicauth. Les crons appellent
	# gtm-app:3000 en direct sur le reseau Docker, pas via Caddy.
	@api path /api/sa/collect /api/sa/report /api/extension/status /api/contacts/from-extension /api/activities/from-extension /api/companies/search-similar /api/webhooks/lemlist
	handle @api {
		reverse_proxy gtm-app:3000
	}
	handle {
		basicauth {
			admin $2y$12$gD0VoOpD2lY0wiOjig/HjOvoGd5qzoMgNtZ/NVcE9qpIXFzkkwW1e
		}
		reverse_proxy gtm-app:3000
	}
}

# --- athletedatahub ---
